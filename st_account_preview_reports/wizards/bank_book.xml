<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bank_book_form_custom" model="ir.ui.view">
        <field name="name">bank.book.preview</field>
        <field name="model">account.bank.book.report</field>
        <field name="inherit_id" ref="base_accounting_kit.account_bank_book_form_view"/>
        <field name="arch" type="xml">
            <footer>
                <xpath expr="//field/form/footer/button[@name='check_report']" position="before">
                    <button string="Preview" name="preview_bank_book" type="object" class="btn-primary"/>
                </xpath>
            </footer>
        </field>
    </record>
</odoo>
