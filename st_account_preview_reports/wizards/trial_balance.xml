<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_trial_balance_form_custom" model="ir.ui.view">
        <field name="name">trial.balance.preview</field>
        <field name="model">account.balance.report</field>
        <field name="inherit_id" ref="base_accounting_kit.account_report_balance_view"/>
        <field name="arch" type="xml">
            <footer>
                <xpath expr="//field/form/footer/button[@name='check_report']" position="before">
                    <button string="Preview" name="preview_trial_balance" type="object" class="btn-primary"/>
                </xpath>
            </footer>
        </field>
    </record>
</odoo>
