<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_aged_partner_form_custom" model="ir.ui.view">
        <field name="name">aged.partner.preview</field>
        <field name="model">account.aged.trial.balance</field>
        <field name="inherit_id" ref="base_accounting_kit.account_aged_balance_view"/>
        <field name="arch" type="xml">
            <footer>
                <xpath expr="//field/form/footer/button[@name='check_report']" position="before">
                    <button string="Preview" name="preview_aged_partner" type="object" class="btn-primary"/>
                </xpath>
            </footer>
        </field>
    </record>
</odoo>
