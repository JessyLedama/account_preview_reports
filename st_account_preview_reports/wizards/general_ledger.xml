<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_general_ledger_form_custom" model="ir.ui.view">
        <field name="name">general.ledger.preview</field>
        <field name="model">account.report.general.ledger</field>
        <field name="inherit_id" ref="base_accounting_kit.account_report_general_ledger_view"/>
        <field name="arch" type="xml">
            <footer>
                <xpath expr="//field/form/footer/button[@name='check_report']" position="before">
                    <button string="Preview" name="preview_general_ledger" type="object" class="btn-primary"/>
                </xpath>
            </footer>
        </field>
    </record>
</odoo>
