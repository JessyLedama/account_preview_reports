<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_day_book_form_custom" model="ir.ui.view">
        <field name="name">day.book.preview</field>
        <field name="model">account.day.book.report</field>
        <field name="inherit_id" ref="base_accounting_kit.account_day_book_form_view"/>
        <field name="arch" type="xml">
            <footer>
                <xpath expr="//field/form/footer/button[@name='check_report']" position="before">
                    <button string="Preview" name="preview_day_book" type="object" class="btn-primary"/>
                </xpath>
            </footer>
        </field>
    </record>
</odoo>
