<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_tax_form_custom" model="ir.ui.view">
        <field name="name">cash.flow.preview</field>
        <field name="model">cash.flow.report</field>
        <field name="inherit_id" ref="base_accounting_kit.account_common_report_view"/>
        <field name="arch" type="xml">
            <group>
                <xpath expr="//footer/button[@name='check_report']" position="after">
                    <button string="Preview" name="action_preview" type="object" class="btn-primary"/>
                </xpath>
            </group>
        </field>
    </record>
</odoo>
